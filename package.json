{
  "name": "stick-studio-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Studio de production automatique de vidéos Stickman pour YouTube Shorts",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
